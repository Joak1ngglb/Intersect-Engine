+    // DuelInvitePacket (cliente -> servidor)
+    public void HandlePacket(Client client, Intersect.Network.Packets.Client.DuelInvitePacket packet)
+    {
+        var player = client?.Entity;
+        if (player == null)
+        {
+            return;
+        }
+
+        var target = Player.FindOnline(packet.TargetId);
+        if (target != null && target.Id != player.Id && player.InRangeOf(target, Options.Instance.Player.TradeRange))
+        {
+            target.InviteToDuel(player);
+            return;
+        }
+
+        PacketSender.SendChatMsg(player, Strings.Duels.OutOfRange, ChatMessageType.Combat, CustomColors.Combat.NoTarget);
+    }
+
+    // DuelInviteResponsePacket (cliente -> servidor)
+    public void HandlePacket(Client client, Intersect.Network.Packets.Client.DuelInviteResponsePacket packet)
+    {
+        var player = client?.Entity;
+        if (player == null)
+        {
+            return;
+        }
+
+        var inviter = Player.FindOnline(packet.InviterId);
+        if (inviter == null)
+        {
+            return;
+        }
+
+        if (player.DuelRequester != null && player.DuelRequester.Id == inviter.Id)
+        {
+            if (packet.Accepting)
+            {
+                Player.StartDuel(inviter, player);
+            }
+            else
+            {
+                PacketSender.SendChatMsg(inviter, string.Format(Strings.Duels.Declined, player.Name), ChatMessageType.Party, CustomColors.Alerts.Declined);
+            }
+
+            player.DuelRequester = null;
+        }
+    }
+
