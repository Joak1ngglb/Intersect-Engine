+using MessagePack;
+
+namespace Intersect.Network.Packets.Server;
+
+[MessagePackObject]
+public partial class DuelStatePacket : IntersectPacket
+{
+    public DuelStatePacket()
+    {
+    }
+
+    public DuelStatePacket(Guid duelId, Guid playerAId, string playerAName, int playerAKills, Guid playerBId, string playerBName, int playerBKills, bool finished = false, Guid winnerId = default)
+    {
+        DuelId = duelId;
+        PlayerAId = playerAId;
+        PlayerAName = playerAName;
+        PlayerAKills = playerAKills;
+        PlayerBId = playerBId;
+        PlayerBName = playerBName;
+        PlayerBKills = playerBKills;
+        Finished = finished;
+        WinnerId = winnerId;
+    }
+
+    [Key(0)] public Guid DuelId { get; set; }
+    [Key(1)] public Guid PlayerAId { get; set; }
+    [Key(2)] public string PlayerAName { get; set; }
+    [Key(3)] public int PlayerAKills { get; set; }
+    [Key(4)] public Guid PlayerBId { get; set; }
+    [Key(5)] public string PlayerBName { get; set; }
+    [Key(6)] public int PlayerBKills { get; set; }
+    [Key(7)] public bool Finished { get; set; }
+    [Key(8)] public Guid WinnerId { get; set; }
+}
