diff --git a/Intersect.Client.Core/Interface/Game/DuelWindow.cs b/Intersect.Client.Core/Interface/Game/DuelWindow.cs
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/Intersect.Client.Core/Interface/Game/DuelWindow.cs
@@ -0,0 +1,116 @@
+using Intersect.Client.Framework.Gwen.Control;
+using Intersect.Client.Framework.Gwen;
+using Intersect.Client.Networking;
+using Intersect.Network.Packets.Server;
+
+namespace Intersect.Client.Interface.Game;
+
+public partial class DuelWindow : Window
+{
+    private readonly RichLabel _titleLabel;
+    private readonly RichLabel _scoreLabel;
+
+    public DuelWindow(Canvas canvas) : base(canvas, name: nameof(DuelWindow))
+    {
+        IsHidden = true;
+        DeleteOnClose = false;
+
+        Width = 360;
+        Height = 72;
+
+        _titleLabel = new RichLabel(this)
+        {
+            Dock = Pos.Top,
+            Text = string.Empty,
+            FontSize = 14,
+            AutoSizeToContents = false,
+            Alignment = [Alignments.Center]
+        };
+
+        _scoreLabel = new RichLabel(this)
+        {
+            Dock = Pos.Fill,
+            Text = string.Empty,
+            FontSize = 12,
+            AutoSizeToContents = false,
+            Alignment = [Alignments.Center]
+        };
+
+        X = (Canvas.Width - OuterWidth) / 2;
+        Y = 20;
+    }
+
+    public void SetState(Intersect.Network.Packets.Server.DuelStatePacket state)
+    {
+        if (state == null)
+        {
+            IsHidden = true;
+            return;
+        }
+
+        _titleLabel.Text = $"PvP: {state.PlayerAName} vs {state.PlayerBName}";
+        _scoreLabel.Text = $"{state.PlayerAName}: {state.PlayerAKills}  —  {state.PlayerBName}: {state.PlayerBKills}";
+
+        IsHidden = false;
+
+        if (state.Finished)
+        {
+            var winnerName = state.WinnerId == state.PlayerAId ? state.PlayerAName : state.PlayerBName;
+            PacketSender.SendChatMsg($@"{winnerName} ha ganado el duelo.", 0);
+            Timer.SetTimeout(() => IsHidden = true, 5000);
+        }
+    }
+}
